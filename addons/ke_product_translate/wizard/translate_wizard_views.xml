<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ke_translate_wizard_form" model="ir.ui.view">
        <field name="name">ke.translate.wizard.form</field>
        <field name="model">ke.translate.wizard</field>
        <field name="arch" type="xml">
            <form string="Traduci testi sito">
                <p class="text-muted">
                    Traduce i testi della scheda "Sito web" (nome sul sito, meta, descrizioni; l'URL si
                    ricava dal nome tradotto). Nome e descrizione di vendita del prodotto non cambiano.
                    Fino a 5 prodotti si traduce subito, oltre il lavoro va in coda in background.
                </p>
                <group>
                    <field name="product_count"/>
                    <field name="product_ids" invisible="1"/>
                    <field name="provider_id" options="{'no_create': True}"/>
                    <field name="source_lang"/>
                    <field name="target_lang_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="scope" widget="radio"/>
                    <field name="apply" widget="radio"/>
                </group>
                <footer>
                    <button name="action_translate" type="object" string="Traduci" class="btn-primary"/>
                    <button special="cancel" string="Annulla"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ke_translate_wizard" model="ir.actions.act_window">
        <field name="name">Traduci testi sito</field>
        <field name="res_model">ke.translate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,kanban,form</field>
        <field name="group_ids" eval="[(4, ref('product.group_product_manager'))]"/>
    </record>
</odoo>
