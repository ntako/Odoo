<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amazon_ship_to_fba_wizard_form" model="ir.ui.view">
        <field name="name">ke.amazon.ship.wizard.form</field>
        <field name="model">ke.amazon.ship.wizard</field>
        <field name="arch" type="xml">
            <form string="Spedisci rifornimento ad Amazon FBA">
                <group>
                    <field name="source_warehouse_id"/>
                    <field name="marketplace_id"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="product_id"/>
                        <field name="quantity"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm"
                            string="Conferma spedizione"
                            type="object"
                            class="btn btn-primary"/>
                    <button name="action_print_all_fnsku_labels"
                            string="Stampa tutte le etichette"
                            type="object"
                            class="btn btn-secondary"
                            confirm="Stampare le etichette FNSKU di tutti i prodotti in elenco (una copia per unità)? Non sono ancora legate a nessun trasferimento (verrà creato solo confermando la spedizione) — verifica di avere in mano le unità corrette prima di confermare."/>
                    <button string="Annulla" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_amazon_ship_to_fba_wizard" model="ir.actions.act_window">
        <field name="name">Spedisci rifornimento ad Amazon FBA</field>
        <field name="res_model">ke.amazon.ship.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
