<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amazon_inbound_box_scan_wizard_form" model="ir.ui.view">
        <field name="name">ke.amazon.inbound.box.scan.wizard.form</field>
        <field name="model">ke.amazon.inbound.box.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Scansiona articoli nel collo">
                <group>
                    <field name="box_id" readonly="1"/>
                    <field name="ean_scan" placeholder="Scansiona o digita l'EAN..." autofocus="1"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="not last_scan_message">
                    <field name="last_scan_message" readonly="1" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_scan"
                            string="Scansiona"
                            type="object"
                            class="btn btn-primary"/>
                    <button string="Chiudi" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_amazon_inbound_box_scan_wizard" model="ir.actions.act_window">
        <field name="name">Scansiona articoli nel collo</field>
        <field name="res_model">ke.amazon.inbound.box.scan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
