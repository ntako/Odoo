<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amazon_receive_from_fba_wizard_form" model="ir.ui.view">
        <field name="name">ke.amazon.receive.wizard.form</field>
        <field name="model">ke.amazon.receive.wizard</field>
        <field name="arch" type="xml">
            <form string="Registra rientro scorte da Amazon FBA">
                <group>
                    <field name="dest_warehouse_id"/>
                    <field name="marketplace_id"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="product_id"/>
                        <field name="quantity"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm"
                            string="Conferma ricezione"
                            type="object"
                            class="btn btn-primary"/>
                    <button string="Annulla" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_amazon_receive_from_fba_wizard" model="ir.actions.act_window">
        <field name="name">Registra rientro scorte da Amazon FBA</field>
        <field name="res_model">ke.amazon.receive.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
