<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amazon_fba_standalone_label_wizard_form" model="ir.ui.view">
        <field name="name">ke.amazon.fba.standalone.label.wizard.form</field>
        <field name="model">ke.amazon.fba.standalone.label.wizard</field>
        <field name="arch" type="xml">
            <form string="Stampa etichetta FNSKU">
                <group>
                    <field name="ean_scan" placeholder="Scansiona o digita l'EAN..." autofocus="1"/>
                    <field name="product_id"/>
                    <field name="quantity"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="not last_scan_message">
                    <field name="last_scan_message" readonly="1" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_scan"
                            string="Identifica"
                            type="object"
                            class="btn btn-secondary"/>
                    <button name="action_print"
                            string="Stampa copie"
                            type="object"
                            class="btn btn-primary"/>
                    <button string="Chiudi" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_amazon_fba_standalone_label_wizard" model="ir.actions.act_window">
        <field name="name">Stampa etichetta FNSKU</field>
        <field name="res_model">ke.amazon.fba.standalone.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
