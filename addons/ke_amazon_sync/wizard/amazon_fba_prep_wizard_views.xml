<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amazon_fba_prep_wizard_form" model="ir.ui.view">
        <field name="name">ke.amazon.fba.prep.wizard.form</field>
        <field name="model">ke.amazon.fba.prep.wizard</field>
        <field name="arch" type="xml">
            <form string="Etichettatura FBA">
                <field name="picking_id" invisible="1"/>
                <group>
                    <field name="ean_scan" placeholder="Scansiona o digita l'EAN..." autofocus="1"/>
                    <field name="scan_quantity"/>
                    <field name="force_reprint"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="not last_scan_message">
                    <field name="last_scan_message" readonly="1" nolabel="1"/>
                </div>
                <field name="move_ids" nolabel="1">
                    <list>
                        <field name="product_id"/>
                        <field name="product_uom_qty" string="Prevista"/>
                        <field name="x_amazon_labeled_qty" string="Etichettata"/>
                        <button name="action_print_fnsku_label" string="Stampa" type="object"
                                icon="fa-print"
                                context="{'fnsku_force_reprint': parent.force_reprint, 'fnsku_quantity': parent.scan_quantity}"
                                confirm="Stampare le etichette FNSKU di QUESTA riga? Senza 'Forza ristampa' stampa in un unico documento tutte quelle ancora mancanti (Prevista - Etichettata); con 'Forza ristampa' spuntata ristampa 'Quantità' copie, anche se la riga è già completata. Verifica di avere in mano le unità corrette prima di confermare."/>
                    </list>
                </field>
                <footer>
                    <button name="action_scan"
                            string="Scansiona / stampa"
                            type="object"
                            class="btn btn-primary"/>
                    <button name="action_validate_picking"
                            string="Conferma spedizione"
                            type="object"
                            class="btn btn-secondary"
                            confirm="Tutte le unità sono state etichettate? La spedizione verrà chiusa (stato 'Fatto')."/>
                    <button string="Chiudi" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_amazon_fba_prep_wizard" model="ir.actions.act_window">
        <field name="name">Etichettatura FBA</field>
        <field name="res_model">ke.amazon.fba.prep.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
