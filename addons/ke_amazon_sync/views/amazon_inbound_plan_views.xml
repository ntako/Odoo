<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Collo: form proprio (bottoni di scansione/chiusura), apribile cliccando
         una riga nella lista colli del piano (comportamento di default di Odoo
         per un one2many non editabile con una form view disponibile). -->
    <record id="view_amazon_inbound_plan_box_form" model="ir.ui.view">
        <field name="name">ke.amazon.inbound.plan.box.form</field>
        <field name="model">ke.amazon.inbound.plan.box</field>
        <field name="arch" type="xml">
            <form string="Collo">
                <header>
                    <button name="action_scan_items" string="Scansiona articoli" type="object"
                            class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_fill_remaining" string="Metti tutto il rimanente" type="object"
                            class="btn-secondary" invisible="state != 'open'"
                            help="Aggiunge a questo collo tutti gli articoli del trasferimento non ancora in nessun collo: con un solo collo, l'intero trasferimento senza riscansionare."/>
                    <button name="action_close_box" string="Chiudi collo" type="object"
                            class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_reopen_box" string="Riapri collo" type="object"
                            class="btn-secondary" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                    <group string="Dimensioni e peso">
                        <field name="length_cm"/>
                        <field name="width_cm"/>
                        <field name="height_cm"/>
                        <field name="weight_kg"/>
                    </group>
                    <field name="line_ids" readonly="state != 'open'">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_amazon_inbound_plan_box_list" model="ir.ui.view">
        <field name="name">ke.amazon.inbound.plan.box.list</field>
        <field name="model">ke.amazon.inbound.plan.box</field>
        <field name="arch" type="xml">
            <list string="Colli">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="state" widget="badge" decoration-success="state == 'closed'"/>
                <field name="length_cm"/>
                <field name="width_cm"/>
                <field name="height_cm"/>
                <field name="weight_kg"/>
            </list>
        </field>
    </record>

    <record id="view_amazon_inbound_plan_shipment_list" model="ir.ui.view">
        <field name="name">ke.amazon.inbound.plan.shipment.list</field>
        <field name="model">ke.amazon.inbound.plan.shipment</field>
        <field name="arch" type="xml">
            <list string="Spedizioni" create="0" delete="0">
                <field name="amazon_shipment_id"/>
                <field name="shipment_confirmation_id"/>
                <field name="destination_fc_name"/>
                <field name="transportation_option_id"/>
                <field name="delivery_window_option_id"/>
                <field name="tracking_number"/>
            </list>
        </field>
    </record>

    <record id="view_amazon_inbound_plan_form" model="ir.ui.view">
        <field name="name">ke.amazon.inbound.plan.form</field>
        <field name="model">ke.amazon.inbound.plan</field>
        <field name="arch" type="xml">
            <form string="Piano inbound FBA">
                <header>
                    <!-- Un bottone per ogni decisione vera (2026-10-30): i passi senza
                         scelte si concatenano da soli e ci si ferma prima dei due che
                         impegnano. I metodi dei singoli passi restano nel modello. -->
                    <button name="action_prepare_placement" string="Crea piano e prepara collocazione"
                            type="object" class="btn-primary" invisible="state != 'draft'"
                            help="Crea il piano su Amazon, conferma l'imballaggio, invia i colli e genera le opzioni di collocazione. Nessuno di questi passi impegna; si ferma prima della conferma della collocazione."/>
                    <button name="action_prepare_placement" string="Riprendi preparazione collocazione"
                            type="object" class="btn-primary"
                            invisible="state not in ('plan_created', 'packing_confirmed', 'packing_info_sent')"/>
                    <button name="action_confirm_placement_option" string="Conferma collocazione (IRREVERSIBILE)"
                            type="object" class="btn-danger" invisible="state != 'placement_options_ready'"
                            confirm="Confermi l'opzione di collocazione SCELTA nella scheda Opzioni? È IRREVERSIBILE lato Amazon: non si può più annullare o cambiare. Dopo, Odoo prepara da solo finestre di consegna e preventivi di trasporto."/>
                    <button name="action_prepare_transport" string="Prepara trasporto"
                            type="object" class="btn-primary"
                            invisible="state not in ('placement_confirmed', 'delivery_window_options_ready', 'delivery_window_confirmed')"/>
                    <button name="action_confirm_transportation_options" string="Conferma trasporto"
                            type="object" class="btn-danger" invisible="state != 'transport_options_ready'"
                            confirm="Confermi il trasporto SCELTO nella scheda Opzioni? Impegna il corriere e il relativo costo. Dopo, Odoo scarica da solo le etichette dei colli."/>
                    <button name="action_get_labels" string="Scarica etichette collo"
                            type="object" class="btn-primary" invisible="state != 'transport_confirmed'"/>
                    <button name="action_download_labels" string="Scarica PDF etichette"
                            type="object" class="btn-primary" icon="fa-download" invisible="state != 'labels_ready'"/>
                    <button name="action_get_labels" string="Riscarica etichette"
                            type="object" class="btn-secondary" invisible="state != 'labels_ready'"
                            help="Di nuovo da Amazon, per esempio dopo aver cambiato il formato."/>
                    <button name="action_mark_shipped" string="Segna come spedito"
                            type="object" class="btn-secondary" invisible="state != 'labels_ready'"/>
                    <button name="action_reset_to_draft" string="Riporta in bozza"
                            type="object" class="btn-secondary"
                            invisible="state != 'error' or amazon_inbound_plan_id"/>
                    <button name="action_cancel_plan" string="Annulla piano"
                            type="object" class="btn-secondary"
                            invisible="state in ('transport_confirmed', 'labels_ready', 'shipped', 'done', 'cancelled', 'error')"
                            confirm="Annullare il piano? Prima della conferma del trasporto l'annullamento non è garantito a costo zero dalla documentazione Amazon."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,placement_options_ready,transport_options_ready,labels_ready,shipped"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not error_message">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'placement_confirmed' or confirmed_date == False">
                        Collocazione confermata il <field name="confirmed_date" readonly="1" nolabel="1"/>
                        da <field name="confirmed_by" readonly="1" nolabel="1"/> — irreversibile.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="picking_id" readonly="state != 'draft'"/>
                            <field name="marketplace_id" readonly="state != 'draft'"/>
                            <field name="amazon_inbound_plan_id"/>
                        </group>
                        <group>
                            <field name="source_name"/>
                            <field name="source_address_line1"/>
                            <field name="source_city"/>
                            <field name="source_state_code"/>
                            <field name="source_postal_code"/>
                            <field name="source_country_code"/>
                            <field name="source_email"/>
                            <field name="source_phone"/>
                            <!-- Solo lettura su Amazon (listInboundPlans): indirizzo,
                                 telefono ed email dell'ultimo piano già creato. -->
                            <button name="action_copy_source_address_from_amazon"
                                    string="Copia indirizzo dall'ultimo piano Amazon"
                                    type="object" class="btn-link" icon="fa-download"
                                    invisible="state != 'draft'" colspan="2"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Colli">
                            <!-- Colli creati SOLO dal bottone "Aggiungi collo" (create="0"),
                                 non dalla riga "Aggiungi" della lista: un collo nuovo nel
                                 dialog x2many veniva salvato da solo dai bottoni
                                 Scansiona/Chiudi (beforeExecuteActionButton) e poi di
                                 nuovo da "Salva" ("Invalid ids list: false"), e serviva
                                 il piano già salvato (segnalati dal vivo il 2026-10-30).
                                 Il bottone del form salva prima il piano e apre un collo
                                 già esistente. Modificabili fino all'invio del contenuto
                                 colli (setPackingInformation), non oltre. -->
                            <button name="action_add_box" string="Aggiungi collo" type="object"
                                    class="btn-secondary" icon="fa-plus"
                                    invisible="state not in ('draft', 'plan_created', 'packing_confirmed')"/>
                            <field name="box_ids" readonly="state not in ('draft', 'plan_created', 'packing_confirmed')">
                                <list create="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="state" widget="badge" decoration-success="state == 'closed'"/>
                                    <field name="length_cm"/>
                                    <field name="width_cm"/>
                                    <field name="height_cm"/>
                                    <field name="weight_kg"/>
                                </list>
                            </field>
                        </page>
                        <page string="Opzioni" invisible="not option_ids">
                            <field name="option_ids" invisible="1"/>
                            <!-- Scelta esplicita (2026-10-30): prima Odoo prendeva sempre la
                                 prima opzione, anche per collocazione e trasporto. -->
                            <separator string="Collocazione" invisible="not placement_option_line_ids"/>
                            <field name="placement_option_line_ids" readonly="1" nolabel="1"
                                   invisible="not placement_option_line_ids">
                                <list decoration-bf="is_selected" decoration-success="is_selected">
                                    <field name="is_selected" widget="boolean_toggle" readonly="1"/>
                                    <field name="description"/>
                                    <field name="cost"/>
                                    <field name="currency_code"/>
                                    <field name="expiration"/>
                                    <button name="action_select" string="Scegli" type="object" icon="fa-check"
                                            invisible="is_selected or parent.state != 'placement_options_ready'"/>
                                </list>
                            </field>
                            <separator string="Trasporto (corrieri partner Amazon)" invisible="not transport_option_line_ids"/>
                            <field name="transport_option_line_ids" readonly="1" nolabel="1"
                                   invisible="not transport_option_line_ids">
                                <list decoration-bf="is_selected" decoration-success="is_selected">
                                    <field name="is_selected" widget="boolean_toggle" readonly="1"/>
                                    <field name="shipment_id"/>
                                    <field name="description"/>
                                    <field name="cost"/>
                                    <field name="currency_code"/>
                                    <field name="expiration"/>
                                    <button name="action_select" string="Scegli" type="object" icon="fa-check"
                                            invisible="is_selected or parent.state != 'transport_options_ready'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Spedizioni">
                            <group>
                                <field name="label_page_type"/>
                            </group>
                            <field name="shipment_ids" readonly="1">
                                <list>
                                    <field name="shipment_confirmation_id"/>
                                    <field name="destination_fc_name"/>
                                    <field name="box_count"/>
                                    <field name="box_contents"/>
                                    <field name="amazon_shipment_id" optional="hide"/>
                                    <field name="transportation_option_id" optional="hide"/>
                                    <field name="delivery_window_option_id" optional="hide"/>
                                    <field name="labels_attachment_id" column_invisible="1"/>
                                    <button name="action_download_labels" string="Etichette" type="object"
                                            icon="fa-download" invisible="not labels_attachment_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Opzioni Amazon (grezzo)">
                            <field name="last_options_raw" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_amazon_inbound_plan_list" model="ir.ui.view">
        <field name="name">ke.amazon.inbound.plan.list</field>
        <field name="model">ke.amazon.inbound.plan</field>
        <field name="arch" type="xml">
            <list string="Piani inbound FBA" default_order="id desc">
                <field name="name"/>
                <field name="picking_id"/>
                <field name="marketplace_id"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('shipped', 'done')"
                       decoration-danger="state == 'error'"
                       decoration-warning="state == 'placement_confirmed'"/>
                <field name="create_date" string="Creato"/>
            </list>
        </field>
    </record>

    <record id="action_amazon_inbound_plan" model="ir.actions.act_window">
        <field name="name">Piani inbound FBA</field>
        <field name="res_model">ke.amazon.inbound.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
