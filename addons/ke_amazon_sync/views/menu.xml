<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server action import completo -->
    <record id="action_amazon_full_import_server" model="ir.actions.server">
        <field name="name">Import Completo da Amazon</field>
        <field name="model_id" ref="ke_amazon_sync.model_ke_amazon_sync_log"/>
        <field name="state">code</field>
        <field name="code">action = env['ke.amazon.sync.log'].action_start_full_import()</field>
    </record>

    <!-- Server action aggiornamento da Catalog API -->
    <record id="action_apply_cat_mapping_server" model="ir.actions.server">
        <field name="name">Aggiorna da Catalog API</field>
        <field name="model_id" ref="ke_amazon_sync.model_ke_amazon_sync_log"/>
        <field name="state">code</field>
        <field name="code">action = env['ke.amazon.sync.log'].action_start_apply_category_mapping()</field>
    </record>

    <!-- Menu sotto Inventario > Operazioni -->
    <menuitem id="menu_amazon_sync_root"
              name="Amazon Sync"
              parent="stock.menu_stock_root"
              sequence="99"/>

    <!-- Il click diretto su "Import Completo" apriva prima l'import subito;
         ora apre la vista dei report scaricati (gestione/selezione), così
         si può controllare/riusare un report già scaricato invece di
         richiederne sempre uno nuovo — vedi TASK.md. L'avvio vero e proprio
         resta lo stesso action_start_full_import di sempre, ora raggiungibile
         dal menu "Avvia Full Import" sotto. -->

    <!-- Server action import ordini -->
    <record id="action_amazon_import_orders_server" model="ir.actions.server">
        <field name="name">Import Ordini Amazon</field>
        <field name="model_id" ref="ke_amazon_sync.model_ke_amazon_sync_log"/>
        <field name="state">code</field>
        <field name="code">action = env['ke.amazon.sync.log'].action_start_import_orders()</field>
    </record>

    <record id="action_amazon_sale_orders" model="ir.actions.act_window">
        <field name="name">Ordini Amazon</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_amazon_order_id', '!=', False)]</field>
    </record>

    <!-- Server action sync giacenze FBA -->
    <record id="action_amazon_sync_fba_server" model="ir.actions.server">
        <field name="name">Sync Giacenze FBA</field>
        <field name="model_id" ref="ke_amazon_sync.model_ke_amazon_sync_log"/>
        <field name="state">code</field>
        <field name="code">action = env['ke.amazon.sync.log'].action_start_sync_fba_quantities()</field>
    </record>

    <!-- Server action import resi -->
    <record id="action_amazon_returns_server" model="ir.actions.server">
        <field name="name">Import Resi Amazon</field>
        <field name="model_id" ref="ke_amazon_sync.model_ke_amazon_sync_log"/>
        <field name="state">code</field>
        <field name="code">action = env['ke.amazon.sync.log'].action_start_returns_report()</field>
    </record>

    <!-- Shortcut impostazioni: apre le Impostazioni direttamente sulla tab Amazon -->
    <record id="action_amazon_config_settings" model="ir.actions.act_window">
        <field name="name">Configurazione Amazon</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'ke_amazon_sync'}</field>
    </record>

    <!-- Server action import FNSKU -->
    <record id="action_amazon_fnsku_import_server" model="ir.actions.server">
        <field name="name">Import FNSKU</field>
        <field name="model_id" ref="ke_amazon_sync.model_ke_amazon_sync_log"/>
        <field name="state">code</field>
        <field name="code">action = env['ke.amazon.sync.log'].action_start_fnsku_import()</field>
    </record>

    <!-- Stampa autonoma per variante e numero di copie, senza spedizione/
         trasferimento — vedi TASK.md "Etichette" (priorità 2026-10-27) e
         progetto-odoo-amazon-fba-etichettatura.md §7. Il flusso legato alla
         spedizione (action_open_amazon_fba_prep_wizard) resta sul picking. -->

    <!-- Multi-marketplace: tutte le sync (fase 3, vedi TASK.md) leggono/scrivono
         questi due modelli per ogni marketplace attivo. -->

    <!-- Agente di stampa ZPL (Windows) — vedi
         progetto-odoo-amazon-fba-etichettatura.md §6/§8. Solo la coda/
         configurazione lato Odoo per ora; l'agente vero gira sul PC del
         magazzino e non è ancora scritto (vedi TASK.md). -->

    <!-- Spedizioni inbound FBA (Fulfillment Inbound API v2024-03-20) — vedi
         progetto-odoo-amazon-fba-etichettatura.md §10 Priorità 3 e
         RICERCA_fulfillment_inbound_api_sandbox_2026-10-29.md per il confine
         di sicurezza (confirmPlacementOption è irreversibile). -->

    <!-- Menu Amazon Sync per sezioni (2026-11-11, chiesto dall'utente): le
         operazioni rare o pesanti (Full Import, richiesta report, import
         ordini/resi/FNSKU, sync giacenze FBA, Catalog API, spostamento verso
         il Magazzino Generale) non sono più nel menu ma in Configurazione
         Amazon → "Sincronizzazioni manuali", con conferma, per non premerle
         per sbaglio. -->
    <menuitem id="menu_amazon_section_operations" name="Operazioni" parent="menu_amazon_sync_root" sequence="10"/>
    <menuitem id="menu_amazon_product_inventory_list" name="Vista Inventario" parent="menu_amazon_section_operations" action="action_product_inventory_list" sequence="10"/>
    <menuitem id="menu_amazon_sale_orders" name="Ordini Amazon" parent="menu_amazon_section_operations" action="action_amazon_sale_orders" sequence="20"/>
    <menuitem id="menu_amazon_ship_to_fba" name="Spedisci rifornimento ad Amazon FBA" parent="menu_amazon_section_operations" action="action_amazon_ship_to_fba_wizard" sequence="30"/>
    <menuitem id="menu_amazon_inbound_plan" name="Piani inbound FBA" parent="menu_amazon_section_operations" action="action_amazon_inbound_plan" sequence="40"/>
    <menuitem id="menu_amazon_receive_from_fba" name="Registra rientro scorte da Amazon FBA" parent="menu_amazon_section_operations" action="action_amazon_receive_from_fba_wizard" sequence="50"/>
    <menuitem id="menu_amazon_allocate_fbm" name="Alloca giacenza per Amazon FBM" parent="menu_amazon_section_operations" action="action_amazon_allocate_fbm_wizard" sequence="60"/>
    <menuitem id="menu_amazon_fba_standalone_label" name="Stampa etichetta FNSKU" parent="menu_amazon_section_operations" action="action_amazon_fba_standalone_label_wizard" sequence="70"/>
    <menuitem id="menu_amazon_listing_new" name="Nuova inserzione" parent="menu_amazon_section_operations" action="action_amazon_listing_new_wizard" sequence="80"/>

    <menuitem id="menu_amazon_section_catalog" name="Catalogo e prezzi" parent="menu_amazon_sync_root" sequence="20"/>
    <menuitem id="menu_amazon_listing" name="Inserzioni per marketplace" parent="menu_amazon_section_catalog" action="action_amazon_listing" sequence="10"/>
    <menuitem id="menu_amazon_resell_offer" name="Offerte usato (Grade &amp; Resell)" parent="menu_amazon_section_catalog" action="action_amazon_resell_offer" sequence="20"/>
    <menuitem id="menu_amazon_price_analysis" name="Analisi prezzi" parent="menu_amazon_section_catalog" action="action_amazon_price_analysis" sequence="30"/>
    <menuitem id="menu_amazon_category_map" name="Corrispondenze categorie" parent="menu_amazon_section_catalog" action="action_amazon_category_map" sequence="40"/>

    <menuitem id="menu_amazon_section_logs" name="Registri" parent="menu_amazon_sync_root" sequence="30"/>
    <menuitem id="menu_amazon_sync_log" name="Log Sincronizzazioni" parent="menu_amazon_section_logs" action="action_amazon_sync_log" sequence="10"/>
    <menuitem id="menu_amazon_fba_label_log" name="Etichette FBA stampate" parent="menu_amazon_section_logs" action="action_amazon_fba_label_log" sequence="20"/>
    <menuitem id="menu_amazon_print_job" name="Lavori di stampa ZPL" parent="menu_amazon_section_logs" action="action_amazon_print_job" sequence="30"/>
    <menuitem id="menu_amazon_full_import" name="Report Amazon scaricati" parent="menu_amazon_section_logs" action="action_amazon_report" sequence="40"/>

    <menuitem id="menu_amazon_section_config" name="Configurazione" parent="menu_amazon_sync_root" sequence="40" groups="stock.group_stock_manager"/>
    <menuitem id="menu_amazon_sync_settings" name="Configurazione Amazon" parent="menu_amazon_section_config" action="action_amazon_config_settings" sequence="10"/>
    <menuitem id="menu_amazon_marketplace" name="Marketplace" parent="menu_amazon_section_config" action="action_amazon_marketplace" sequence="20"/>
    <menuitem id="menu_amazon_print_station" name="Postazioni agente di stampa" parent="menu_amazon_section_config" action="action_amazon_print_station" sequence="30"/>
</odoo>
