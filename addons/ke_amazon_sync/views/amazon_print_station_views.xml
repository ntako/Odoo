<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amazon_print_station_form" model="ir.ui.view">
        <field name="name">ke.amazon.print.station.form</field>
        <field name="model">ke.amazon.print.station</field>
        <field name="arch" type="xml">
            <form string="Postazione agente di stampa">
                <header>
                    <button name="action_generate_api_key"
                            string="Genera nuova chiave API"
                            type="object"
                            class="btn-primary"
                            confirm="Una chiave esistente smette subito di funzionare: l'agente configurato con quella vecchia non potrà più autenticarsi finché non viene aggiornato. Continuare?"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="last_seen"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_amazon_print_station_list" model="ir.ui.view">
        <field name="name">ke.amazon.print.station.list</field>
        <field name="model">ke.amazon.print.station</field>
        <field name="arch" type="xml">
            <list string="Postazioni agente di stampa">
                <field name="name"/>
                <field name="last_seen"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_amazon_print_station" model="ir.actions.act_window">
        <field name="name">Postazioni agente di stampa</field>
        <field name="res_model">ke.amazon.print.station</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
