<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Menu principale PrestaShop sotto Inventario -->
    <menuitem id="menu_prestashop_root"
              name="PrestaShop"
              parent="stock.menu_stock_root"
              sequence="90"
              groups="stock.group_stock_manager"/>

    <menuitem id="menu_ps_log"
              name="Log sincronizzazioni"
              parent="menu_prestashop_root"
              action="action_ps_sync_log"
              sequence="10"/>

    <menuitem id="menu_ps_import_products"
              name="Import prodotti da PS"
              parent="menu_prestashop_root"
              action="action_ps_product_import"
              sequence="20"/>

    <menuitem id="menu_ps_export_products"
              name="Export prodotti verso PS"
              parent="menu_prestashop_root"
              action="action_ps_product_export"
              sequence="30"/>

    <menuitem id="menu_ps_category_mapping"
              name="Mappatura categorie"
              parent="menu_prestashop_root"
              action="action_product_category_ps_mapping"
              sequence="40"/>

    <menuitem id="menu_ps_categories"
              name="Categorie PrestaShop"
              parent="menu_prestashop_root"
              action="action_ke_prestashop_category"
              sequence="45"/>

    <!-- Apre le Impostazioni direttamente sulla sezione PrestaShop
         (l'azione generale apriva la prima sezione, Impostazioni generali). -->
    <record id="action_ps_config_settings" model="ir.actions.act_window">
        <field name="name">Impostazioni PrestaShop</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'ke_prestashop_sync', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_ps_settings"
              name="Impostazioni"
              parent="menu_prestashop_root"
              action="action_ps_config_settings"
              sequence="100"/>

</odoo>
