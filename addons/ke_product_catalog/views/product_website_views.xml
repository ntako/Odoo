<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_ke_website" model="ir.ui.view">
        <field name="name">product.template.form.ke.website</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Sito web" name="ke_website">
                    <div class="mb-3">
                        <button name="action_ke_web_propose" type="object" string="Proponi testi sito"
                                class="btn btn-secondary"
                                help="Compila i campi vuoti dal nome e dalla descrizione di vendita. Non tocca quelli già scritti."/>
                        <span class="text-muted ms-2">Testi della pagina prodotto sul sito, separati da quelli Amazon. Per le famiglie valgono per tutte le varianti.</span>
                    </div>
                    <group>
                        <group string="Pagina">
                            <field name="ke_web_name" placeholder="es. DAM Quick 1"/>
                            <field name="ke_web_slug" placeholder="es. dam-quick-1"/>
                        </group>
                        <group string="Google">
                            <field name="ke_web_meta_title"/>
                            <div colspan="2" class="text-end small"
                                 invisible="not ke_web_meta_title">
                                <span invisible="ke_web_meta_title_len &gt; 60" class="text-success"><field name="ke_web_meta_title_len" class="d-inline"/> / 60 caratteri</span>
                                <span invisible="ke_web_meta_title_len &lt;= 60" class="text-danger">Troppo lungo per Google (oltre 60 caratteri)</span>
                            </div>
                            <field name="ke_web_meta_description"/>
                            <div colspan="2" class="text-end small"
                                 invisible="not ke_web_meta_description">
                                <span invisible="ke_web_meta_description_len &gt; 160" class="text-success"><field name="ke_web_meta_description_len" class="d-inline"/> / 160 caratteri</span>
                                <span invisible="ke_web_meta_description_len &lt;= 160" class="text-danger">Troppo lunga per Google (oltre 160 caratteri)</span>
                            </div>
                        </group>
                    </group>
                    <separator string="Descrizione breve"/>
                    <field name="ke_web_short_description" nolabel="1"/>
                    <separator string="Descrizione"/>
                    <field name="ke_web_description" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_ke_web_propose_server" model="ir.actions.server">
        <field name="name">Proponi testi sito</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">action = records.action_ke_web_propose()</field>
    </record>
</odoo>
