<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ke_product_brand_list" model="ir.ui.view">
        <field name="name">ke.product.brand.list</field>
        <field name="model">ke.product.brand</field>
        <field name="arch" type="xml">
            <list decoration-warning="to_review">
                <field name="name"/>
                <field name="product_count"/>
                <field name="to_review" widget="boolean_toggle"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ke_product_brand_merge_form" model="ir.ui.view">
        <field name="name">ke.product.brand.merge.form</field>
        <field name="model">ke.product.brand.merge</field>
        <field name="arch" type="xml">
            <form>
                <p>I prodotti passano alla marca scelta; i nomi delle marche unite diventano suoi
                    nomi alternativi, così gli import futuri le riconoscono.</p>
                <group>
                    <field name="brand_ids" widget="many2many_tags"/>
                    <field name="target_id"/>
                </group>
                <footer>
                    <button name="action_merge" type="object" string="Unisci" class="btn-primary"/>
                    <button special="cancel" string="Annulla"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ke_product_brand_merge" model="ir.actions.act_window">
        <field name="name">Unisci marche</field>
        <field name="res_model">ke.product.brand.merge</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_ke_product_brand"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="view_ke_product_brand_form" model="ir.ui.view">
        <field name="name">ke.product.brand.form</field>
        <field name="model">ke.product.brand</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Conferma marca" class="btn-primary"
                            invisible="not to_review"/>
                    <button name="%(action_ke_product_brand_merge)d" type="action" string="Unisci in…"
                            context="{'active_model': 'ke.product.brand', 'active_ids': [id]}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_products" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Prodotti"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Da verificare" bg_color="text-bg-warning" invisible="not to_review"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nome della marca"/></h1>
                    </div>
                    <group>
                        <field name="to_review"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Nomi alternativi" name="aliases">
                            <p class="text-muted">
                                Nomi con cui la stessa marca arriva da Amazon, dai file dei fornitori o
                                dalle fatture. Maiuscole, spazi, punteggiatura e ragione sociale (Srl,
                                International…) sono già ignorati nel confronto.
                            </p>
                            <field name="alias_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ke_product_brand_search" model="ir.ui.view">
        <field name="name">ke.product.brand.search</field>
        <field name="model">ke.product.brand</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('alias_ids.name', 'ilike', self)]"/>
                <filter name="to_review" string="Da verificare" domain="[('to_review', '=', True)]"/>
                <filter name="archived" string="Archiviate" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_ke_product_brand_alias_list" model="ir.ui.view">
        <field name="name">ke.product.brand.alias.list</field>
        <field name="model">ke.product.brand.alias</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="brand_id" placeholder="(non è una marca)"/>
            </list>
        </field>
    </record>

    <record id="action_ke_product_brand" model="ir.actions.act_window">
        <field name="name">Marche</field>
        <field name="res_model">ke.product.brand</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_ke_product_brand_alias" model="ir.actions.act_window">
        <field name="name">Nomi alternativi marche</field>
        <field name="res_model">ke.product.brand.alias</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_ke_product_brand_alias_import_form" model="ir.ui.view">
        <field name="name">ke.product.brand.alias.import.form</field>
        <field name="model">ke.product.brand.alias.import</field>
        <field name="arch" type="xml">
            <form>
                <p>Tabella "nome trovato → marca": prima colonna il nome com'è (Amazon, fornitore…),
                    colonna "Marca corretta" la marca. Marca vuota = "non è una marca". Es. il foglio
                    "Marche" di fornitori_e_marche.xlsx.</p>
                <group>
                    <field name="file_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                    <field name="sheet_name"/>
                    <field name="result" invisible="not result"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Importa" class="btn-primary"
                            invisible="result"/>
                    <button special="cancel" string="Chiudi"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ke_product_brand_alias_import" model="ir.actions.act_window">
        <field name="name">Importa corrispondenze marche</field>
        <field name="res_model">ke.product.brand.alias.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Direttamente nella sezione "Prodotti" di Magazzino → Configurazione: il menu a
         tendina di Odoo mostra solo sezione + voci, un sottomenu più profondo non compare. -->
    <menuitem id="menu_ke_product_brand" name="Marche" parent="stock.menu_product_in_config_stock"
              action="action_ke_product_brand" sequence="30"/>
    <menuitem id="menu_ke_product_brand_alias" name="Nomi alternativi marche" parent="stock.menu_product_in_config_stock"
              action="action_ke_product_brand_alias" sequence="31"/>
    <menuitem id="menu_ke_product_brand_alias_import" name="Importa corrispondenze marche" parent="stock.menu_product_in_config_stock"
              action="action_ke_product_brand_alias_import" sequence="32"/>

    <!-- Marca sul prodotto -->
    <record id="view_product_template_form_brand" model="ir.ui.view">
        <field name="name">product.template.form.ke.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="before">
                <field name="ke_brand_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_search_brand" model="ir.ui.view">
        <field name="name">product.template.search.ke.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="ke_brand_id"/>
                <filter name="group_ke_brand" string="Marca" context="{'group_by': 'ke_brand_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_list_brand" model="ir.ui.view">
        <field name="name">product.template.list.ke.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="ke_brand_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
