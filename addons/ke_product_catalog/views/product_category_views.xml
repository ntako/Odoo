<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_view_ke_web_name" model="ir.ui.view">
        <field name="name">product.category.form.ke.web.name</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="ke_web_name" placeholder="Nome nel menu del sito (tradotto)"/>
            </xpath>
        </field>
    </record>
</odoo>
